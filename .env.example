# ── Telegram
# Two ways in, and they do different jobs. Set either; setting both runs as the bot.
#
#   A bot  — publishes. No phone number, nothing tied to your personal account. It can only
#            ever see chats it was ADDED to, so it cannot read rival groups. That is a
#            Telegram rule, not something we can work around.
#   You    — reads. A logged-in account is the only thing that can watch other groups, which
#            is what the ratings table is built from. It is also bannable, which is why the
#            channel is better owned by the bot.
#
# Start with the bot. Add the account later, when you want to track other groups.

# From @BotFather → /newbot. Whoever holds this owns the bot — treat it like a password.
TG_BOT_TOKEN=

# ── Telegram MTProto, for the reading account
# (get these at https://my.telegram.org → API development tools)
TG_API_ID=
TG_API_HASH=

# Produced by `npm run setup`. This is a full account credential — treat it like a password.
TG_SESSION=

# ── Destinations
# Where public calls go. Numeric id (-100...) or @username. Numeric id is faster (no resolve).
PUMPGOD_CHANNEL=

# If that group has Topics turned on, which topic to publish into. The topic's own link
# ("Copy Link" on the topic) or just its number. Empty posts to General.
PUMPGOD_TOPIC=

# Private staging chat where you approve/reject calls with one tap.
# Leave empty to disable manual review (everything then follows each source's mode).
WAR_ROOM_CHAT=

# Same again, if the war room is a topic rather than a chat of its own.
WAR_ROOM_TOPIC=

# ── Behaviour
# Global kill switch. When false, nothing is ever posted to the public channel.
LIVE=false

# Which chains we are willing to call. Anything else is dropped before it reaches the
# channel, and `/signal` on an off-chain address is refused with a reason rather than
# silently ignored. Comma-separated chain names, or `all` for no restriction.
# Solana only to start: it is where the volume is, and it is the one chain whose whole
# path — price, liquidity screen, Buy link — we have actually proven end to end.
CHAINS=solana

# Post the coin's own artwork as a photo, with the call as its caption. Only applies to
# calls we resolve up front (`/signal`); a relayed call is a race and has no image yet.
SHOW_IMAGE=true

# Show which group we picked the call up from, in the PUBLIC message.
SHOW_SOURCE=false

# Seconds before the same contract may be called again.
DEDUPE_TTL_SEC=21600

# Fire the message immediately, then edit in market data when it arrives.
ENRICH_ENABLED=true
ENRICH_TIMEOUT_MS=2500

# A call older than this never auto-fires — it goes to the war room for a human instead.
# This is what stops a call recovered after an outage being posted as if it were fresh.
MAX_CALL_AGE_SEC=90

# How often to check each source for messages missed while the socket was down.
CATCHUP_INTERVAL_SEC=60

# How often to re-price tracked calls, for `npm run scorecard`.
TRACK_INTERVAL_SEC=60

# Footer appended to public calls.
FOOTER=NFA · DYOR

# ── Money
# Where the Buy button points. {address} and {chain} are substituted.
# Leave EVM blank until you have picked a terminal — blank falls back to a DexScreener
# search, which is honest about being a search rather than pretending to be a swap.
TRADE_URL_SOL=https://axiom.trade/t/{address}
TRADE_URL_EVM=

# Your signup referral link, shown once per public call.
# These terminals attribute a referral when someone SIGNS UP through your link, then pay you
# a share of their fees forever — so the revenue comes from this line being read on every
# call, not from decorating each Buy button. Get yours from the terminal's referral
# dashboard and paste the whole link. Never commit it: it lives here, and .env is gitignored.
REFERRAL_URL=
REFERRAL_LABEL=Trade these faster

# ── Growth (X / Twitter)
# Public link to the Telegram channel. Every recap post ends with it — without it the posts
# are proof of a track record with nowhere to convert.
CHANNEL_URL=https://t.me/pumpgod_fun

# Credentials from developer.x.com → your app → Keys and tokens. All four are needed, and the
# access token pair must be regenerated with Read AND Write permission or posting 403s.
# Leave blank to keep the feed off; `npm run recap` still previews what it would post.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Smallest multiple worth a post. The free X tier allows ~500 posts/month, and posting every
# 2x both burns that and trains people to scroll past.
X_MIN_MULTIPLE=5

# One scoreboard post per day, covering the day before. Includes the denominator: a group
# that only ever shows its winners is the one nobody believes.
X_DAILY_RECAP=true
X_POST_INTERVAL_SEC=300

# ── Ops
LOG_LEVEL=info
METRICS_INTERVAL_SEC=300
