{
  "name": "pumpgod",
  "version": "0.1.0",
  "private": true,
  "description": "Lightning-fast memecoin call relay. Tracks other call groups over MTProto and fires to our channel in milliseconds.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "TZ=Asia/Tokyo vitest run",
    "test:watch": "TZ=Asia/Tokyo vitest",
    "call": "tsx scripts/call.ts",
    "login": "tsx scripts/login.ts",
    "setup": "tsx scripts/setup.ts",
    "doctor": "tsx scripts/doctor.ts",
    "drill": "tsx scripts/drill.ts",
    "dialogs": "tsx scripts/list-dialogs.ts",
    "bench": "tsx scripts/bench.ts",
    "replay": "tsx scripts/replay.ts",
    "recap": "tsx scripts/recap.ts",
    "shadow": "tsx scripts/shadow.ts",
    "scorecard": "tsx scripts/scorecard.ts",
    "scoreboard": "tsx scripts/scoreboard.ts",
    "leaderboard": "tsx scripts/leaderboard.ts",
    "digest": "tsx scripts/digest.ts"
  },
  "engines": {
    "node": ">=18.14.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  }
}
